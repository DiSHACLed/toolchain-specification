# Ontology for the generic semantic description of pipelines
# Registry of pipeline components 
# Example pipeline

@prefix : <http://example.org/ldio#> .
@prefix ldio: <http://example.org/ldio/types/> .
@prefix ex: <http://example.org/example/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Core ontology (classes and properties)
#################################################################

# Classes
:Pipeline a rdfs:Class .
:PipelineComponent a rdfs:Class .
:Processor a rdfs:Class; rdfs:subClassOf :PipelineComponent .
:ProcessorInstance a rdfs:Class .
:Implementer a rdfs:Class ; rdfs:subClassOf :PipelineComponent .
:ImplementerInstance a rdfs:Class .
:ConfigSchema a rdfs:Class .
:Config a rdfs:Class .
:DataFlow a rdfs:Class .
:DataSchema a rdfs:Class .
:Constraint a rdfs:Class .
:Dockerfile a rdfs:Class .
:Documentation a rdfs:Class .


# Properties
:instantiates a rdf:Property ;
    rdfs:domain :ProcessorInstance, ImplementerInstance ;
    rdfs:range :Processor, Implementer .

:permitsConfig a rdf:Property ;
    rdfs:domain :PipelineComponent ;
    rdfs:range :ConfigSchema .

:implementerConfig a rdf:Property ;
    rdfs:domain :ImplementerInstance ;
    rdfs:range :Config .

:processorConfig a rdf:Property ;
    rdfs:domain :ProcessorInstance ;
    rdfs:range :Config .

:buildSpec a rdf:Property ;
    rdfs:domain :PipelineComponent ;
    rdfs:range :Dockerfile .

:flowFrom a rdf:Property ;
    rdfs:domain :DataFlow ;
    rdfs:range :ProcessorInstance .

:flowTo a rdf:Property ;
    rdfs:domain :DataFlow ;
    rdfs:range :ProcessorInstance .

:consistsOf a rdf:Property ;
    rdfs:domain :Pipeline ;
    rdfs:range :ProcessorInstance .

:hasConstraint a rdf:Property ;
    rdfs:domain :PipelineComponent ;
    rdfs:range :Constraint .

:hasDocumentation a rdf:Property ;
    rdfs:domain :PipelineComponent ;
    rdfs:range :Documentation .

:runs a rdf:Property ;
    rdfs:domain :ImplementerInstance ;
    rdfs:range :ImplementerInstance, :ProcessorInstance .

:inputDataSchema a rdf:Property ;
    rdfs:domain :Processor ;
    rdfs:range :DataSchema .

:outputDataSchema a rdf:Property ;
    rdfs:domain :Processor ;
    rdfs:range :DataSchema .



#################################################################
# Processor registry (as reusable resources)
#################################################################

ldio:LDESclient
    a :Processor ;
    :permitsConfig [a :ConfigSchema ;
                    :name "LDES client config (YAML)" ;
                    :format "yaml" ;
                    :minOccurs 1 ;
                    :maxOccurs 1 .].
    :hasConstraint :NoForwardToInputConstraint. # Add constraint that its instance can receive flowTo but not flowFrom from Dataflow

# SHACL SPARQL constraint: LDES client processor instances MUST NOT be the object of any :forwardsTo
# (i.e., they should not receive forwarded input)
:NoForwardToInputConstraint
    a sh:NodeShape ;
    sh:targetClass :ProcessorInstance ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Processor instances that implement ldio:LDESclient must not be the object of a :forwardsTo triple." ;
        sh:select """
SELECT $this WHERE {
  ?s :forwardsTo $this .
  $this :implementsProcessor ldio:LDESclient .
}
"""
    ] .


ldio:GeoJsonToWktTransformer
    a :Processor ;
    :permitsConfig [a :ConfigSchema ;
                    :name "transform-to-rdf+wkt-enabled" ;
                    :format "boolean" ;
                    :default false ;
                    :minOccurs 0 ;
                    :maxOccurs 1 .] .



#################################################################
# Implementer registry (as resuable resources)
#################################################################

:LinkedDataInteractionsOrchestrator
    a :Implementer ;
    rdfs:label "LDIO Orchestrator (implementer)" ;
    :buildSpec :LDIODockerfile ;
    :hasConstraint :SingleFlowChainShape ;
    :documentation :LDIODocumentation .

:LDIODockerfile a :Dockerfile ;
    :dockerString """
FROM ldes/ldi-orchestrator:2.4.0-SNAPSHOT

# Copy your configuration into the image
COPY ldio.config.yml /ldio/application.yml

# Expose the port the application listens on
EXPOSE 8080
""" .

:LDIODocumentation a :Documentation ;
    dct:title "LDIO docs" ;
    dct:description "Documentation landing page for LDIO" ;
    dct:identifier <https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/index> .


:SingleFlowChainShape
    a sh:NodeShape ;
    sh:targetClass :ProcessorInstance ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message """
A ProcessorInstance executed by an ImplementerInstance that instantiates
a LinkedDataInteractionsOrchestrator may have at most one flowFrom and
at most one flowTo DataFlow.
""" ;

        sh:select """
SELECT $this WHERE {

  # Check whether this ProcessorInstance is run by an ImplementerInstance
  # that instantiates a LinkedDataInteractionsOrchestrator
  ?implInst :runs $this .
  ?implInst :instantiates :LinkedDataInteractionsOrchestrator .

  # Count number of incoming flows (flowFrom)
  {
    SELECT (COUNT(?dfIn) AS ?incomingFlows) WHERE {
      ?dfIn :flowTo $this .
    }
  }

  # Count number of outgoing flows (flowTo)
  {
    SELECT (COUNT(?dfOut) AS ?outgoingFlows) WHERE {
      ?dfOut :flowFrom $this .
    }
  }

  # Violation if either is > 1
  FILTER (?incomingFlows > 1 || ?outgoingFlows > 1)
}
""" 
    ] .

# Also add constraint that any processor using the LDIO Implementer and sending via http channel, has to use port 8080



#################################################################
# Processor instances and pipeline example
#################################################################

:LDESClientInstance
    a :ProcessorInstance ;
    :instantiates ldio:LDESclient ;
    :processorConfig """
urls:
  - http://localhost:8080/my-ldes
sourceFormat: text/turtle
retries:
  enabled: true
""" .

:GeoJsonToWktTransformerInstance
    a :ProcessorInstance ;
    :instantiates ldio:GeoJsonToWktTransformer ;
    :processorConfig [ :transform_to_rdf_wkt_enabled true ] .

:DataflowClientToTransform
    a :DataFlow ;
    :flowFrom :LDESClientInstance ; 
    :flowTo :GeoJsonToWktTransformerInstance .

:LDIOIngest a :Pipeline ;
    :consistsOf :LDESClientInstance, :GeoJsonToWktTransformerInstance .



############################################################
# Generic SHACL shapes for validating the entire pipeline 
############################################################

# Input and output of linked processor instances must match
:MatchingIOShape a sh:NodeShape ;
sh:targetClass :DataFlow ;
sh:sparql [
a sh:SPARQLConstraint ;
sh:message "Input and output types of processors in a dataflow must match." ;
sh:select """
SELECT $this WHERE {
$this :from ?a ; :to ?b .
?a :implementsProcessor ?pa .
?b :implementsProcessor ?pb .
?pa :output ?out .
?pb :input ?in .
FILTER (?out != ?in)
}
"""
] .


# Each processor instance must be linked via a DataFlow
:LinkedViaDataFlowShape a sh:NodeShape ;
sh:targetClass :ProcessorInstance ;
sh:or (
[ sh:path ^:flowFrom ]
[ sh:path ^:flowTo ]
) ;
sh:message "Each processor instance must participate in at least one dataflow (incoming or outgoing)." .


# Each processor must appear as object of :consistsOf
:ProcessorUsedInPipelineShape a sh:NodeShape ;
sh:targetClass :Processor ;
sh:property [
sh:path ^:implementsProcessor/^:consistsOf ;
sh:minCount 1 ;
sh:message "Each processor type must appear in at least one pipeline via consistsOf." ;
] .


# Shape: every ProcessorInstance MUST implement a Processor
:ProcessorInstanceShape
    a sh:NodeShape ;
    sh:targetClass :ProcessorInstance ;
    sh:property [
        sh:path :implementsProcessor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A ProcessorInstance must declare which Processor type it implements." ;
    ] .

# End of file
