@prefix : <http://example.org/ldio#> .
@prefix ldio: <http://example.org/ldio/types/> .
@prefix ex: <http://example.org/example/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Pipeline
#################################################################

:LDESClientInstance
    a :ProcessorInstance ;
    :instantiates ldio:LDESclient ;
    :configuredAs [ a :Config ; 
                   :isFormat "yaml" ; 
                   :literal    
                            """
                            urls:
                                - http://localhost:8080/my-ldes
                            sourceFormat: text/turtle
                            retries:
                                enabled: true
                            """
    ] . 


:GeoJsonToWktTransformerInstance
    a :ProcessorInstance ;
    :instantiates ldio:GeoJsonToWktTransformer ;
    :configuredAs [a :Config ; 
                   :embedded [ :transform_to_rdf_wkt_enabled true ]
    ] .
    

:DataflowClientToTransform
    a :DataFlow ;
    :flowFrom :LDESClientInstance ; 
    :flowTo :GeoJsonToWktTransformerInstance .


:LDIOIngest a :Pipeline ;
    rdfs:label "LDIO Ingest Pipeline" ;
    :consistsOf :LDESClientInstance, :GeoJsonToWktTransformerInstance .