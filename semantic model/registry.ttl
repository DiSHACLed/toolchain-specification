@prefix : <http://example.org/ldio#> .
@prefix ldio: <http://example.org/ldio/types/> .
@prefix ex: <http://example.org/example/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Processors
#################################################################

ldio:LDESclient
    a :Processor ;
    :isImplementedBy :LinkedDataInteractionsOrchestrator ;
    ldio:type "Input" ; # This is a custom property unique to LDIO
    :permitsConfig [ a :ConfigSchema ; 
                     :isFormat "json-schema" ; # Try it with JSON schema
                     :expectedFormat "yaml" ; 
                     :literal 
                     """
                      {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "title": "ConfigSchema",
                        "type": "object",
                        "properties": {
                          "urls": {
                            "type": "array",
                            "items": { "type": "string", "format": "uri" },
                            "minItems": 1
                          },
                          "sourceFormat": { "type": "string" },
                          "materialisation": {
                            "type": "object",
                            "properties": {
                              "enabled": { "type": "boolean" }
                            },
                            "required": ["enabled"],
                            "additionalProperties": false
                          },
                          "retries": {
                            "type": "object",
                            "properties": {
                              "enabled": { "type": "boolean" },
                              "max": { "type": "integer" },
                              "statuses-to-retry": { "type": "string" }
                            },
                            "required": ["enabled"],
                            "additionalProperties": false
                          },
                          "auth": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": ["OAUTH2_CLIENT_CREDENTIALS", "API_KEY"]
                              },
                              "client-id": { "type": "string" },
                              "client-secret": { "type": "string" },
                              "token-endpoint": { "type": "string", "format": "uri" },
                              "api-key": { "type": "string" },
                              "api-key-header": { "type": "string" }
                            },
                            "required": ["type"],
                            "additionalProperties": false
                          },
                          "state": { "type": "string", "enum": ["postgres"] },
                          "postgres": {
                            "type": "object",
                            "properties": {
                              "url": { "type": "string" },
                              "username": { "type": "string" },
                              "password": { "type": "string" }
                            },
                            "required": ["url", "username", "password"],
                            "additionalProperties": false
                          },
                          "http": {
                            "type": "object",
                            "properties": {
                              "headers": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "key": { "type": "string" },
                                    "value": { "type": "string" }
                                  },
                                  "required": ["key", "value"],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": ["headers"],
                            "additionalProperties": false
                          },
                          "rate-limit": {
                            "type": "object",
                            "properties": {
                              "enabled": { "type": "boolean" },
                              "period": { "type": "string" },
                              "limit": { "type": "integer" }
                            },
                            "required": ["enabled"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["urls", "retries", "auth"],
                        "additionalProperties": false
                      }
                     """
                      ] .
    
    
ldio:GeoJsonToWktTransformer
    a :Processor ;
    :isImplementedBy :LinkedDataInteractionsOrchestrator ;
    ldio:type "Transformer" ; 
    :permitsConfig [
        a :ConfigSchema ;
        :expectedFormat "yaml" ;
        :embeddedShape [
            a sh:NodeShape ;
            sh:property [
                sh:path :transform_to_rdf_wkt_enabled
                sh:name "transform-to-rdf+wkt-enabled" ; # The name is the fieldname that is expected in the config at runtime. It is needed in case it differs from the path
                sh:minCount 0 ;
                sh:maxCount 1 ;
                sh:datatype xsd:boolean
            ]
        ]
    ] .


#################################################################
# Implementers
#################################################################

:LinkedDataInteractionsOrchestrator
    a :Implementer ;
    rdfs:label "Linked Data Interactions Orchestrator" ;
    :hasConstraint :SingleFlowChainShape ; #
    :documentation :LDIODocumentation ;
    :buildSpec [
                                  a :Dockerfile ;
                                  :dockerString """
                                  FROM ldes/ldi-orchestrator:2.4.0-SNAPSHOT

                                  # Copy your configuration into the image
                                  COPY ldio.config.yml /ldio/application.yml

                                  # Expose the port the application listens on
                                  EXPOSE 8080
                                  """
    ] .


:LDIODocumentation a :Documentation ;
    dct:title "LDIO docs" ;
    dct:description "Documentation landing page for LDIO" ;
    dct:identifier <https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/index> .


:SingleFlowChainShape
    a sh:NodeShape ;
    sh:targetClass :ProcessorInstance ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message """
A ProcessorInstance executed by an ImplementerInstance that instantiates
a LinkedDataInteractionsOrchestrator may have at most one flowFrom and
at most one flowTo DataFlow.
""" ;

        sh:select """
SELECT $this WHERE {

  # Check whether this ProcessorInstance is run by an ImplementerInstance
  # that instantiates a LinkedDataInteractionsOrchestrator
  ?implInst :runs $this .
  ?implInst :instantiates :LinkedDataInteractionsOrchestrator .

  # Count number of incoming flows (flowFrom)
  {
    SELECT (COUNT(?dfIn) AS ?incomingFlows) WHERE {
      ?dfIn :flowTo $this .
    }
  }

  # Count number of outgoing flows (flowTo)
  {
    SELECT (COUNT(?dfOut) AS ?outgoingFlows) WHERE {
      ?dfOut :flowFrom $this .
    }
  }

  # Violation if either is > 1
  FILTER (?incomingFlows > 1 || ?outgoingFlows > 1)
}
""" 
    ] .

# Also add constraint that any processor using the LDIO Implementer and sending via http channel, has to use port 8080
# Also add constraint that processors must be of LDIO type "Input", "Adapter", "Transformer" and "Output", in that order 

